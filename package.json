{
  "name": "tepna",
  "version": "0.0.0",
  "private": true,
  "description": "Tepna — the -Dex suite (browser-native, 100%-local physiological analyzers). DEV-TOOLING MANIFEST ONLY: private + unpublished, declares NO runtime dependencies, ships nothing, fetched by nothing at runtime — the 100%-local / offline / single-file invariant is untouched (same contract as tsconfig.json / types.yml). It is the command spine that unifies the OWN-THE-BUILD tooling (tools/build.mjs) with the DEV-TOOLCHAIN legs (tsc, ESLint) and the gate runners under one `npm run` surface.",
  "_version_note": "This 0.0.0 is a placeholder, NOT the release identity. The canonical suite SemVer lives ONLY in suite.manifest.json (CONTROLLED-RELEASES-2026-07-05); do not conflate the two. Never hand-bump either — tools/release.mjs stamps suite.manifest.json from pending changes/*.md.",
  "license": "Apache-2.0",
  "author": "Michal Planicka",
  "homepage": "https://github.com/",
  "scripts": {
    "build": "node tools/build.mjs --all",
    "build:app": "node tools/build.mjs --app",
    "build:check": "node tools/build.mjs --check",
    "typecheck": "npx -y -p typescript@5.5.4 tsc --noEmit -p tsconfig.json",
    "lint": "biome ci --no-errors-on-unmatched",
    "lint:only": "biome lint --no-errors-on-unmatched",
    "format": "biome format --write",
    "format:check": "biome ci --no-errors-on-unmatched",
    "format:changed": "biome ci --changed --no-errors-on-unmatched",
    "test": "node tests/run-tests.mjs",
    "test:par": "node tests/run-tests.mjs --jobs=auto",
    "test:shard": "node tests/run-tests.mjs --shard",
    "verify:shard-union": "node tests/verify-shard-union.mjs",
    "test:build-core": "node tests/build-core-tests.mjs",
    "test:trio-anchor": "node tests/trio-anchor-tests.mjs",
    "test:fold-provenance": "node tests/fold-provenance-tests.mjs",
    "test:trio-fold-clock": "node tests/trio-fold-clock-tests.mjs",
    "test:trio-fold-validity": "node tests/trio-fold-validity-tests.mjs",
    "test:seqnet-port": "node tests/seqnet-port-tests.mjs",
    "test:stage-lab-core": "node tests/stage-lab-core-tests.mjs",
    "test:oxydex-stager": "node tests/oxydex-stager-tests.mjs",
    "coverage": "npx -y c8@10.1.2 node tests/run-tests.mjs",
    "coverage:report": "npx -y c8@10.1.2 --reporter=html --reporter=text-summary node tests/run-tests.mjs",
    "coverage:json": "npx -y c8@10.1.2 --reporter=json --report-dir=.mutation-sweeps/cov node tests/run-tests.mjs",
    "mutation:reach": "node tools/mutation-reach.mjs --cov .mutation-sweeps/cov/coverage-final.json",
    "verify:manifest": "node tests/verify-manifest.mjs",
    "verify:fixture-currency": "node tools/verify-fixtures.mjs --check --json",
    "gate:subject": "node tools/gate-subject.mjs",
    "test:hooks": "bash .claude/hooks/guard-shared-tree.test.sh && bash .claude/hooks/guard-stale-brief.test.sh && bash .claude/hooks/guard-stale-ledger.test.sh && bash .claude/hooks/guard-format.test.sh && bash .claude/hooks/guard-trailer.test.sh && bash .claude/hooks/guard-ruff.test.sh && bash .claude/hooks/guard-doc-search.test.sh && bash .claude/hooks/guard-memory-stale.test.sh && bash .claude/hooks/guard-syntax.test.sh && bash .claude/hooks/trim-output.test.sh && bash .claude/hooks/session-tailnet.test.sh && bash .claude/hooks/board-hook.test.sh && bash tools/sync-main.test.sh",
    "check:dex": "node tests/check-dex.mjs",
    "reconcile": "node tests/reconcile-provenance.mjs",
    "gates:browser": "node tests/browser-gates.mjs",
    "gates:browser:local": "node tools/browser-lane.mjs",
    "release": "node tools/release.mjs",
    "release:dry": "node tools/release.mjs --dry-run",
    "release:full": "node tools/release.mjs --full",
    "release:status": "node tools/release-land.mjs --status",
    "check": "node tools/run-check.mjs",
    "rebase": "node tools/rebase-safe.mjs",
    "verify:analysis": "node tools/build-analysis.mjs --check",
    "verify:docs": "node tools/build-docs.mjs --check",
    "verify:codegen": "node codegen/dex-gen.js codegen/manifests/eegdex.manifest.json --check codegen/generated/eegdex-reference.html && node codegen/dex-registry-gen.js codegen/manifests/eegdex.manifest.json | cmp - codegen/generated/eegdex-registry.js",
    "verify:tools-index": "node tools/tools-index.mjs --check",
    "verify:workflow-timeouts": "node tools/workflow-timeout-guard.mjs",
    "verify:verdict-adoption": "node tools/verdict-adoption.mjs --check",
    "verify:absence-regression": "node tools/absence-regression.mjs --base origin/main",
  "verify:astgrep": "node tools/astgrep-gate.mjs",
    "verify:xss-sink": "node tools/xss-sink-gate.mjs --base origin/main",
    "verify:docs-constants": "node tools/docs-constants.mjs",
    "verify:brief-header-claims": "node tools/brief-header-claims.mjs --base origin/main",
    "verify:pr-compliance": "node tools/pr-compliance.mjs",
    "tools-index": "node tools/tools-index.mjs",
    "sync:docs-index": "node tools/sync-docs-index.mjs",
    "test:guards": "bash .claude/hooks/guard-shared-tree.test.sh && bash .claude/hooks/guard-stale-brief.test.sh && bash .claude/hooks/guard-stale-ledger.test.sh && bash .claude/hooks/guard-trailer.test.sh",
    "test:tools": "node tools/selftest-all.mjs",
    "pseudo:check": "node tools/extreme-mutate.mjs --baseline --file",
    "pseudo:baseline": "node tools/extreme-mutate.mjs --write-baseline --file",
    "verify:commit-shape": "node tools/commit-shape.mjs",
    "verify:hook-contract": "node tools/hook-contract.mjs",
    "verify:seals": "node tools/verify-seals.mjs --vectors",
    "verify:residue-ids": "node tools/residue-ids.mjs --base origin/main",
    "verify:residue-claims": "node tools/residue-ids.mjs --full-tree",
    "verify:residue-citations": "node tools/residue-citations.mjs",
    "verify:defect-pins": "node tools/defect-pin-census.mjs",
    "verify:survivor-ratchet": "node tools/mutation-survivors.mjs ratchet --expect 30",
    "verify:flag-exit": "node tools/flag-exit-scan.mjs --check",
    "verify:absence": "node tools/absence-ledger.mjs --ratchet",
    "verify:shard-timings": "node tests/verify-shard-timings.mjs",
    "timings:refresh": "node tests/run-tests.mjs --json | node tests/gen-group-timings.mjs",
    "verify:no-names": "node tools/no-third-party-names.mjs",
    "verify:integrator-surface": "node tools/integrator-surface-gate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.50.0",
    "@biomejs/biome": "2.5.3",
    "acorn": "8.18.0"
  }
}
