[Unit]
Description=Tepna capture daemon (BLE -> vendor-layout files)
# Needs the Bluetooth stack and a synced clock (arrival stamps depend on the clock).
After=bluetooth.target network-online.target time-sync.target
Wants=bluetooth.target network-online.target
# Capture is unattended overnight — never rate-limit restarts (keep retrying across transient BLE drops).
# StartLimitIntervalSec lives in [Unit], not [Service], since systemd v230 — it was silently IGNORED in
# [Service] (a `systemctl status` warned "Unknown key … ignoring"), so the no-give-up intent never applied.
StartLimitIntervalSec=0

[Service]
# notify (not simple): the daemon sends READY=1 once capture is actually up, and heartbeats WATCHDOG=1
# from a live-event-loop task. WatchdogSec turns the box's signature HUNG-BUT-ALIVE failure (a wedged BLE
# stack that captures nothing while the process keeps running) into an automatic kill+restart — Restart
# alone never fires on a wedge because nothing crashes. sd_watchdog() pings at half this interval.
Type=notify
WatchdogSec=120
User=tepna
Group=tepna
WorkingDirectory=/opt/tepna/capture-host
# Use the venv's python (see README install).
ExecStart=/opt/tepna/capture-host/.venv/bin/python capture.py --config /opt/tepna/capture-host/config.yaml
Restart=always
RestartSec=5
# Let it write under /srv/tepna; otherwise lock it down.
ReadWritePaths=/srv/tepna
NoNewPrivileges=true
# ⚠️ THE MONITOR'S CLOCK CONTROLS NEED THIS RELAXED, AND THREE PATHS OPENED. NoNewPrivileges makes sudo
# structurally impossible, so Save&apply / Sync now / Set timezone all fail with "the no new privileges
# flag is set". If you want them, add a DROP-IN (never edit this file, or a redeploy reverts it):
#
#   /etc/systemd/system/tepna-capture.service.d/clock-control.conf
#     [Service]
#     NoNewPrivileges=no
#     ReadWritePaths=-/etc/chrony -/etc/systemd/timesyncd.conf.d -/run/chrony
#
# and grant sudoers on the ROOT-OWNED helper only (see helper_path.py — never the in-repo copy):
#   sudo install -D -o root -g root -m 0755 tepna-clock.sh /usr/local/lib/tepna/tepna-clock.sh
#   vigil ALL=(root) NOPASSWD: /usr/local/lib/tepna/tepna-clock.sh
#
# All three ReadWritePaths were established by an actual failure on a real box (2026-07-25), not guessed:
# ProtectSystem=strict mounts the WHOLE hierarchy read-only except /dev, /proc and /sys — inherited by
# sudo'd children — so /etc/chrony blocks writing the servers and /run/chrony blocks chronyc from
# creating the reply socket it needs to talk to chronyd at all.
# Leaving it as-is is a legitimate choice: timezone and NTP are set-once values, and NoNewPrivileges is
# worth keeping on a box whose control API is unauthenticated by default.
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
