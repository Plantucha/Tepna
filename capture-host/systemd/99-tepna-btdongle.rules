# 50-tepna-btdongle.rules — disable USB autosuspend on the Tepna bedside Bluetooth dongle.
#
# ROOT-CAUSE FIX (VIGIL-OVERNIGHT-FINDINGS-2026-07-24-BRIEF.md §P0.1). The TP-Link UB500 (RTL8761B,
# USB 2357:0604) firmware-hangs when the kernel USB-autosuspends it under an active BLE workload — the
# adapter returns "powered but deaf" (hciN goes DOWN) and only a USB re-enumeration, or a lucky firmware
# self-heal, brings it back. Measured 2026-07-23: two wedges, ~110 min of a sleep capture lost, while a
# healthy internal radio sat idle. `power/control=on` stops the kernel ever suspending the dongle.
#
# ⚠️ THE FILENAME PREFIX IS LOAD-BEARING — 99, NOT 50 (fixed 2026-07-25).
# This shipped as 50-…, and on Ubuntu that silently LOST. udev applies rules in lexical order, and
# /usr/lib/udev/rules.d/60-autosuspend.rules runs AFTER a 50- file and sets power/control back to
# `auto`. Measured on a fresh Ubuntu 26.04 box: rule installed, attributes matching, `udevadm test`
# showing it apply — and `power/control=auto` on every boot regardless. So the P0.1 "root-cause fix"
# was never actually in force; only the daemon's startup self-test revealed it. 99- runs last.
#
# Install (one time, needs root) — and DELETE any older 50- copy, which loses to 60-autosuspend:
#     sudo rm -f /etc/udev/rules.d/50-tepna-btdongle.rules
#     sudo cp capture-host/systemd/99-tepna-btdongle.rules /etc/udev/rules.d/
#     sudo udevadm control --reload
#     sudo udevadm trigger --action=add --subsystem-match=usb    # apply now, no replug
#
# Verify (per radio, not a global count — a `grep -c on` over every USB device proves nothing):
#     for d in /sys/bus/usb/devices/*; do \
#       printf '%s %s:%s %s\n' "$(basename $d)" "$(cat $d/idVendor 2>/dev/null)" \
#         "$(cat $d/idProduct 2>/dev/null)" "$(cat $d/power/control 2>/dev/null)"; done | grep -E '2357|0bda:b850|1915|2fe3'
#
# If you swap dongles, add the new idVendor/idProduct (lsusb) — and disable autosuspend on it too; the
# RTL8761B is not unique in disliking it.

# --- TP-Link UB500 (RTL8761B) — the original bedside dongle -----------------------------------------
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="2357", ATTR{idProduct}=="0604", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="2357", ATTR{idProduct}=="0604", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# --- rig-x870 internal Realtek RTL8851BU (BT half of the RTL8851BE combo card) ----------------------
# Added 2026-07-26: this is now the PINNED adapter (config `adapter: 58:10:31:F3:2C:30`) for the
# dongle-vs-internal A/B the 07-24 brief §3.3 prescribes. It shipped `power/control=auto delay=2000` —
# the EXACT setting that wedged the UB500 — so without this the A/B would compare a de-suspended dongle
# against a suspending internal radio and prove nothing. Product-pinned, NOT vendor-wide: 0bda is
# Realtek at large and this box also carries an 0bda:5411 hub and an 0bda:1100 HID.
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="b850", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="b850", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# --- nRF52840 dongle (the multi-link upgrade path, CAPTURE-HOST §5) ---------------------------------
# Vendor-wide on purpose — this device changes USB ID with its firmware and we must cover every state:
#   1915:* = Nordic — stock app fw AND the Open bootloader's DFU mode (PID differs per mode)
#   2fe3:* = the Zephyr project VID it enumerates under ONCE FLASHED with `hci_usb` (see flash-nrf52840-hci.sh)
# Both VIDs are single-purpose here, so vendor-wide matching cannot catch an unrelated device.
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="1915", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="1915", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="2fe3", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="2fe3", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# --- The M900's internal Intel radio (8260/8265/AX200 — BT half of a combo Wi-Fi card) --------------
# Included so a dongle-vs-internal comparison is not decided by one of them running with autosuspend on.
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="8087", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="8087", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# --- CATCH-ALL: any Bluetooth adapter, whatever its vendor ------------------------------------------
# Everything above is a vendor allowlist, and an allowlist only protects the adapters someone already
# thought of. On 2026-07-26 a Raytac MDBT50Q (2fe3) was plugged into a running box and came up with
# `control=auto delay=2000` because its vendor was not yet listed — the line for it was added the same
# day, which is the point: the list is always one dongle behind.
#
# WHY IT MATCHES THE INTERFACE AND NOT THE DEVICE. USB gives Bluetooth its own class triple —
# bInterfaceClass=e0 (Wireless Controller), SubClass=01 (RF Controller), Protocol=01 (Bluetooth) — and
# every conformant adapter reports it. The DEVICE-level class cannot be used: measured on the box, the
# TP-Link and the Intel report e0/01/01 at device level but the Raytac reports 00/00/00, because
# Zephyr's composite USB descriptor declares the class per-interface only. A device-level rule would
# therefore miss the exact dongle this exists to catch.
#
# WHY IT CALLS THE SCRIPT INSTEAD OF SETTING THE ATTRIBUTES HERE. A rule matching the INTERFACE cannot
# write the parent DEVICE's power/ attributes with ATTR{}, and reimplementing the walk in udev syntax
# would put the same logic in two places — which is exactly how install-services.sh and
# expose-monitor.sh drifted into writing two different Caddyfiles. tepna-usb-autosuspend.sh already
# owns this logic, is idempotent, reports its read-back, and is tested; udev just triggers it.
#
# bInterfaceNumber=="00" because a Bluetooth device exposes TWO matching interfaces (0 = HCI, 1 = SCO)
# and without it the script runs twice per plug for no benefit.
#
# The vendor lines above are KEPT as a declarative fast path: they need no script on disk, so a box
# whose /opt/tepna checkout is missing or mid-deploy still arms the two adapters we ship with.
ACTION=="add|bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="e0", ATTR{bInterfaceSubClass}=="01", ATTR{bInterfaceProtocol}=="01", ATTR{bInterfaceNumber}=="00", TEST=="/opt/tepna/capture-host/systemd/tepna-usb-autosuspend.sh", RUN+="/bin/bash /opt/tepna/capture-host/systemd/tepna-usb-autosuspend.sh"
