# tepna-capture — the box folds its own nights, inside a memory fence
# Copyright 2026 Michal Planicka · SPDX-License-Identifier: Apache-2.0
#
# VIGIL-SELF-SUSTAINED-FOLDING-2026-09-01-BRIEF acceptance 2: "Capture is the protected tenant: the
# fold runs as its own systemd unit with MemoryMax sized to the box, nice, scheduled in the daytime
# dead zone after capture closes; the capture daemon carries negative OOMScoreAdjust. The failure mode
# must be 'tonight's fold is missing', never 'tonight's recording is lost'."
#
# ⚠️ SYSTEM SCOPE, DELIBERATELY — unlike tepna-report.service, which is USER scope because it needs no
# privilege and no fence. This unit's whole purpose is the fence, and a user unit buys two problems it
# does not need: `MemoryMax` then depends on the user manager's cgroup delegation, and the timer dies
# with the login session unless someone remembers `loginctl enable-linger` — the exact silent failure
# the archive-pull timer already hit once (deploy/archive-pull.sh warns about it in its own header).
#
# ⚠️ READING THIS UNIT'S JOURNAL: a SYSTEM unit, so the scope is `journalctl -u tepna-fold`.
# `--user-unit` matches nothing here, raises no error, and returns almost nothing — which reads as a
# quiet box (the same trap tepna-capture.service documents).
#
# No `After=tepna-capture.service` and no dependency in either direction. The fold must never be able
# to cost a recording, and ordering against a daemon that runs permanently would be a claim rather
# than a constraint: `After=` orders STARTS, and capture started at boot.
[Unit]
Description=Tepna — fold this box's own captured nights into node-exports
Documentation=file:/opt/tepna/capture-host/deploy/tepna-fold.sh

[Service]
Type=oneshot
User=vigil
Group=vigil
WorkingDirectory=/opt/tepna/capture-host
ExecStart=/opt/tepna/capture-host/deploy/tepna-fold.sh

# ── THE FENCE ─────────────────────────────────────────────────────────────────────────────────────
# 4G is the brief's own pre-stated bar ("a real box night folds in ≤ 4 GB peak RSS"), so the fence IS
# the acceptance criterion rather than a number chosen beside it. Four real box nights measured
# 1.61 / 1.82 / 2.28 / 2.68 GB in a child process, all exit 0 (P0, 2026-09-11), and the heaviest sat
# 1.3 GB under this ceiling. A night that breaches it is a finding, not a tuning job: raise the bar on
# that evidence and say which night did it.
MemoryMax=4G
# ⚠️ KEEP THIS 0. Swap turns a breach into an hour of thrashing that starves the capture daemon of I/O
# while the fold still looks healthy — the fence has to kill, not slow down. The 2026-08-06 child-heap
# sweep that fixed CHILD_HEAP_MB was run "in its own 8 GB cgroup with swap off" for the same reason:
# with swap on, a peak measurement measures the swap configuration.
MemorySwapMax=0
# Under HOST pressure the kernel must reach for the fold first, and the capture daemon carries the
# matching -500 (deploy/tepna-capture.service). These two numbers are one decision; changing either
# alone breaks the protected-tenant guarantee.
OOMScoreAdjust=500
Nice=19
CPUWeight=20
IOSchedulingClass=idle

# Exit 4 is "nothing this box can fold" — no node runtime, no captures directory, no fold tool. That is
# the shipped state of a box whose Node install is still owed, and a daily failure mail for a decision
# nobody has taken is noise that trains the operator to ignore the unit.
SuccessExitStatus=0 4
# A full corpus fold is minutes per night, serialized under the fence. Three hours is a wide margin
# that still ends a wedged run instead of holding the timer's next firing behind it.
TimeoutStartSec=10800

# ── Writable paths ────────────────────────────────────────────────────────────────────────────────
# /srv/tepna — the captures to read and the trio exports to write.
ProtectSystem=strict
ReadWritePaths=/srv/tepna
ProtectHome=true
# Unlike the capture daemon, the fold reaches no sudo helper, so this is safe to set here. Do NOT copy
# it into tepna-capture.service: there it disables every recovery rung the watchdog has.
NoNewPrivileges=yes
