#
# Tepna — bring changed files into search within 15 minutes (primary dev machine only).
#
# WHY. Before this lane a change reached `--hybrid` search only after the hourly re-embed AND the
# :20 reload. The board lane (2026-10-31) closed that gap for board posts; since 2026-11-05 it covers
# every repo and external file. This unit runs `bge-reindex-driver.sh --board`: the board export, an
# embed of what changed, then an upsert of every file changed since the last good upsert into the
# generation that serves search now. A changed file loses its stale tail; a file gone from the corpus
# loses its docs.
#
# IT WRITES NO GENERATION. The nightly reload stays the source of truth. The upsert overwrites ids,
# which grows the engine's vector graph (xerj-org/xerj#2796); a day of changed files, reset each
# night, keeps that growth small.
[Unit]
Description=Tepna — upsert changed files into the hybrid-search index
After=tepna-hybrid-index.service
Wants=tepna-hybrid-index.service

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
ExecStart=%h/Tepna/tools/bge-reindex-driver.sh --board
