[Unit]
Description=Tepna — rebuild the hybrid-search generation from the vector cache, nightly

[Timer]
# Nightly at 03:20 (owner 2026-11-05: "Take it"). Until then this ran hourly, and each rebuild loaded
# 75,436 docs beside the serving index and stalled searches for minutes (residue row
# `2026-11-03-hybrid-searches-stall-during-the-hourly-generation-load`). Freshness now comes from the
# fast lane: `tepna-board-search.timer` and the hourly re-embed upsert every changed file into the
# serving generation. This rebuild resets the vector-graph growth that those overwrites cause
# (xerj-org/xerj#2796), and drops nothing a current file still holds. 03:20 keeps clear of the
# hourly re-embed at :00–:05 and of the owner's working hours.
OnCalendar=*-*-* 03:20:00
RandomizedDelaySec=600
# A missed night needs no catch-up: the next run reads the CURRENT cache. Persistent=true would
# rebuild at boot, in the middle of the day, which is the stall this timer moved away from.
Persistent=false

[Install]
WantedBy=timers.target
