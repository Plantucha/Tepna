[Unit]
Description=Tepna — search fast lane, every 15 minutes

[Timer]
# Every 15 min (the owner's cadence since 2026-10-31). The driver's window reaches back to its last
# good upsert, so a tick that meets the hourly re-embed's lock and skips loses nothing.
OnCalendar=*-*-* *:00/15:00
RandomizedDelaySec=30
Persistent=false

[Install]
WantedBy=timers.target
